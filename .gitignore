# ==========================================
# 1. Security & Configuration
# ==========================================
# Exclude plain-text database credentials and passwords
config.php

# ==========================================
# 2. Testing & Alternative Files
# ==========================================
# Exclude backup/experimental testing files
index3.html
script3.js
style3.css

# ==========================================
# 3. Media & Directory Layout Safekeeping
# ==========================================
# Ignore all files inside the assets maps folder except .gitkeep
assets/images/maps/*
!assets/images/maps/.gitkeep

# Ignore all 360° panoramas except the placeholder .gitkeep
images/panorama/*
!images/panorama/.gitkeep

# Ignore all static interface/gallery images except the placeholder .gitkeep
images/static/*
!images/static/.gitkeep

# ==========================================
# 4. OS & System Junk Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini

# ==========================================
# 5. Code Editors & IDEs
# ==========================================
.vscode/
.idea/
*.suo
*.swp
